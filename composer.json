{
    "name": "tyhpdef/symfony-console-impl",
    "description": "Implementation package for tyhpdef/symfony-console. Require tyhpdef/symfony-console, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "8.1.7.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/psr-clock": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/symfony-console"
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/console": "8.1.7"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev",
        "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/psr-clock": "@dev"
    }
}
